# Local / Railway Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workout_tracker

# Set to false for local Postgres without SSL
DATABASE_SSL=false

# Date for "today" sessions (gym timezone)
APP_TZ=Europe/Berlin

# Shared app password (required in production)
APP_PASSWORD=change-me

# Random secret used to sign the session cookie (openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
